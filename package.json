{
  "name": "way-ezy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WAY EZY — shopping-centre wayfinding: kiosk, WAY EZY GO mobile PWA and WAY EZY COMMAND admin.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "detect:retail": "tsx scripts/detect-retail-modules.ts",
    "model:ground": "tsx scripts/build-ground-floor-model.ts",
    "test:retail": "tsx --test tests/svg-retail/detection.test.ts",
    "dev": "tsx watch --clear-screen=false --exclude \"apps/web/**\" apps/server/index.ts",
    "build": "npm run prepare:ground && npm run check && vite build && vite build --ssr apps/server/index.ts --outDir dist/server --emptyOutDir",
    "build:demo": "npm run build && tsx scripts/package-release.ts demo",
    "build:release": "npm run build && tsx scripts/package-release.ts production",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/server/db/cli.ts migrate",
    "db:seed": "tsx apps/server/db/cli.ts seed",
    "db:reset": "tsx apps/server/db/cli.ts reset",
    "assets": "tsx scripts/build-assets.tsx",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts",
    "format": "prettier --write apps packages tests scripts vite.config.ts playwright.config.ts index.html package.json tsconfig.json docker-compose.yml .prettierrc.json",
    "format:check": "prettier --check apps packages tests scripts vite.config.ts playwright.config.ts index.html package.json tsconfig.json docker-compose.yml .prettierrc.json",
    "build:video": "tsx scripts/build-demo-video.ts",
    "prepare:ground": "tsx scripts/prepare-ground-directory.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@material-design-icons/svg": "^0.14.15",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "multer": "^2.0.2",
    "pg": "^8.16.0",
    "sharp": "0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "1.63.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  }
}
