# Copy to .env. These defaults run a local demo with MongoDB Community Edition.
# For production, change NODE_ENV and APP_MODE to production, set the values
# marked REQUIRED below, and disable demo seed/users/analytics.
# Explicit shell environment variables override this file.

NODE_ENV=development
APP_MODE=demo
PORT=4173
HOST=0.0.0.0
DATA_DIR=.data
VENUE_ID=riverside
LOG_LEVEL=info

# Local MongoDB Community Edition. Docker Compose supplies its own authenticated URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=wayezy
MONGODB_IMPORT_PGLITE=false

# Local demo login. REQUIRED in production: replace with a 12+ character password.
# Blank password generates one on first demo start in .data/demo-access.txt.
ADMIN_EMAIL=admin@wayezy.in
ADMIN_PASSWORD=admin123
ADMIN_NAME=Centre Administrator

# REQUIRED in production: HTTPS public URL and a random 32+ character secret.
# On a local network, blank PUBLIC_BASE_URL uses the computer's LAN address for QR links.
PUBLIC_BASE_URL=
ROUTE_TOKEN_SECRET=

# Demo content is seeded only into an empty database.
# Set all three to false for production, unless seeding sample content intentionally.
SEED_DEMO=true
DEMO_USERS=true
DEMO_ANALYTICS=true

# Optional server settings. Blank SECURE_COOKIES uses the mode's secure default.
TRUST_PROXY=
SECURE_COOKIES=
SESSION_HOURS=12
QR_TOKEN_TTL_MINUTES=120
ALLOW_UNSIGNED_DEEP_LINKS=
STORAGE_DRIVER=local
MAX_UPLOAD_MB=40

# Docker Compose only. REQUIRED when using its MongoDB service.
MONGO_USERNAME=wayezy
MONGO_PASSWORD=
HOST_PORT=4173

# Optional Supabase media storage. Application records always use MongoDB.
# Set STORAGE_DRIVER=supabase and fill these only if using Supabase for uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=way-ezy-media
